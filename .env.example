# Required. Generate your own values; never commit a real .env file.
ADMIN_PASSCODE=
SESSION_SECRET=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Canonical public URL. Set after the first deployment, then redeploy.
# For local development: http://localhost:3000
BASE_URL=

# Optional invitations. Omit both to copy personal links instead.
RESEND_API_KEY=
MAIL_FROM=
